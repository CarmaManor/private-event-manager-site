Create a new file `.gitignore` at the repo root with the following contents:

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Claude Code
.claude/

# OS
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Editor swap/backup files
*.swp
*.swo
*~
.vscode/

# Logs
*.log

# Local env / secrets
.env
.env.local
.env.*.local

# Node
node_modules/
package-lock.json
npm-debug.log*

# Python
__pycache__/
*.pyc

# Cloudflare Wrangler
.wrangler/
.dev.vars


.dev.vars*
!.dev.vars.example
!.env.example
